{
    "name": "yugo/filament-quran",
    "description": "A configurable Quran provider and Filament dashboard widget.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yugo",
            "email": "dedy.yugo.purwanto@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "filament/filament": "^5.0",
        "yugo/laravel-quran": "^0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "Yugo\\FilamentQuran\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yugo\\FilamentQuran\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yugo\\FilamentQuran\\FilamentQuranServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
